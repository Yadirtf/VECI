# Copie este archivo a backend/.env y ajuste los valores. Nunca suba el .env.
# desarrollo | pruebas | staging | produccion
VECI_ENTORNO=desarrollo
PORT=3000
# Dueño de los objetos: lo usan las migraciones y la semilla.
DATABASE_URL=postgresql://veci:veci@localhost:5432/veci
# Usuario de la API, miembro de veci_app y sujeto a RLS (HU-01-05).
DATABASE_APP_URL=postgresql://veci_api:veci_api@localhost:5432/veci
# En Render: en lugar de DATABASE_APP_URL, la clave de veci_api. Al arrancar se crea el usuario
# y la URL se arma con DATABASE_URL. VECI_SEMBRAR_DEMO=true carga los datos de ejemplo.
# VECI_API_DB_PASSWORD=
# VECI_SEMBRAR_DEMO=false
# Orígenes del panel separados por coma (CORS).
VECI_ORIGENES=http://localhost:3001
# Contrato en /docs (se apaga solo en producción).
VECI_DOCS=true
# Firma de los tokens de sesión (EP-02). Obligatoria en staging y producción (32+ caracteres).
# En local, si queda vacía, se usa una clave de desarrollo.
VECI_TOKENS_SECRETO=
# Secreto de los QR (EP-04, ADR-0017). Obligatorio en staging y producción (32+ caracteres).
# Cambiarlo invalida todos los QR emitidos.
VECI_QR_SECRETO=
# Cabecera x-veci-usuario para pruebas locales sin iniciar sesión.
# Solo funciona en desarrollo y pruebas; en staging y producción se ignora.
VECI_IDENTIDAD_DESARROLLO=true
# Observabilidad (HU-01-07). Vacío = Sentry apagado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
VECI_VERSION=local
