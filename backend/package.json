{
  "name": "veci-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API central de VECI (NestJS, monolito modular con arquitectura limpia).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:cliente": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "start:prod": "prisma migrate deploy && ts-node --transpile-only scripts/preparar-base.ts && node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "arquitectura": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest --selectProjects unitarias",
    "test:int": "jest --selectProjects integracion --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "generar": "prisma generate && ts-node scripts/exportar-openapi.ts",
    "db:migrar": "prisma migrate deploy",
    "db:semilla": "prisma db seed",
    "db:verificar": "bash prisma/verificar-migraciones.sh",
    "db:esquema": "bash prisma/generar-esquema.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arquitectura && pnpm test",
    "db:levantar": "docker compose up -d postgres"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nestjs": "^11.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@nestjs/cli",
      "prisma",
      "unrs-resolver"
    ]
  }
}
