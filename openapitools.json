{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.25.0",
    "generators": {
      "dart": {
        "generatorName": "dart",
        "inputSpec": "packages/api-client/openapi.json",
        "output": "apps/mobile/packages/veci_api",
        "additionalProperties": {
          "pubName": "veci_api",
          "pubLibrary": "veci_api",
          "pubDescription": "Cliente Dart del API de VECI, generado desde el contrato OpenAPI (HU-01-06). No editar a mano.",
          "pubVersion": "0.1.0",
          "pubAuthor": "VECI",
          "pubHomepage": "https://github.com/Yadirtf/VECI"
        }
      }
    }
  }
}
