{
  "components": {
    "schemas": {
      "CambiarEstadoCajeroRequest": {
        "properties": {
          "accion": {
            "enum": [
              "SUSPENDER",
              "REACTIVAR",
              "RETIRAR"
            ],
            "type": "string"
          }
        },
        "required": [
          "accion"
        ],
        "type": "object"
      },
      "CambiarPinRequest": {
        "properties": {
          "pinActual": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "pinNuevo": {
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "pinActual",
          "pinNuevo"
        ],
        "type": "object"
      },
      "CierreRemotoResponse": {
        "properties": {
          "sesionesCerradas": {
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "sesionesCerradas"
        ],
        "type": "object"
      },
      "ComercioActivoRequest": {
        "properties": {
          "comercioId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "comercioId"
        ],
        "type": "object"
      },
      "ComercioActivoResponse": {
        "properties": {
          "comercio": {
            "$ref": "#/components/schemas/EspacioResponse"
          },
          "permisos": {
            "example": [
              "consumptions.register"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "comercio",
          "permisos"
        ],
        "type": "object"
      },
      "CorreoResponse": {
        "properties": {
          "correo": {
            "example": "marta@lavecina.co",
            "type": "string"
          }
        },
        "required": [
          "correo"
        ],
        "type": "object"
      },
      "CorreoYContrasenaRequest": {
        "properties": {
          "contrasena": {
            "example": "almuerzo2026",
            "minLength": 8,
            "type": "string"
          },
          "correo": {
            "example": "marta@lavecina.co",
            "type": "string"
          },
          "pinActual": {
            "description": "PIN actual, para confirmar que eres tú",
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "correo",
          "contrasena",
          "pinActual"
        ],
        "type": "object"
      },
      "CrearHorarioRequest": {
        "properties": {
          "dia": {
            "description": "Código del día (catálogo de días)",
            "example": "MONDAY",
            "type": "string"
          },
          "horaFin": {
            "example": "15:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          },
          "horaInicio": {
            "example": "11:30",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          },
          "sedeId": {
            "description": "Sede donde aplica el horario",
            "format": "uuid",
            "type": "string"
          },
          "servicioId": {
            "description": "Servicio (desayuno, almuerzo...)",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "servicioId",
          "sedeId",
          "dia",
          "horaInicio",
          "horaFin"
        ],
        "type": "object"
      },
      "DispositivoRequest": {
        "properties": {
          "id": {
            "description": "Id que el dispositivo generó para sí",
            "format": "uuid",
            "type": "string"
          },
          "modelo": {
            "example": "Moto E13",
            "type": "string"
          },
          "plataforma": {
            "enum": [
              "ANDROID",
              "IOS",
              "WEB"
            ],
            "type": "string"
          },
          "versionApp": {
            "example": "0.2.0",
            "type": "string"
          },
          "versionSo": {
            "example": "Android 13",
            "type": "string"
          }
        },
        "required": [
          "id",
          "plataforma"
        ],
        "type": "object"
      },
      "DispositivoResponse": {
        "properties": {
          "dispositivoId": {
            "format": "uuid",
            "type": "string"
          },
          "nombre": {
            "example": "Moto E13",
            "nullable": true,
            "type": "string"
          },
          "plataforma": {
            "example": "ANDROID",
            "type": "string"
          },
          "registradoEn": {
            "format": "date-time",
            "type": "string"
          },
          "sesiones": {
            "items": {
              "$ref": "#/components/schemas/SesionEnDispositivoResponse"
            },
            "type": "array"
          },
          "ultimaVez": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "dispositivoId",
          "plataforma",
          "registradoEn",
          "ultimaVez",
          "sesiones"
        ],
        "type": "object"
      },
      "EspacioResponse": {
        "properties": {
          "comercioId": {
            "format": "uuid",
            "type": "string"
          },
          "invitacionPendiente": {
            "description": "Lo invitaron como cajero y aún no ha entrado a este negocio",
            "type": "boolean"
          },
          "nombre": {
            "example": "Restaurante La Vecina",
            "type": "string"
          },
          "roles": {
            "description": "OWNER, CASHIER o CUSTOMER",
            "example": [
              "CASHIER"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tipoNegocio": {
            "description": "Código del tipo de negocio",
            "example": "RESTAURANT",
            "type": "string"
          }
        },
        "required": [
          "comercioId",
          "nombre",
          "tipoNegocio",
          "roles",
          "invitacionPendiente"
        ],
        "type": "object"
      },
      "HorarioResponse": {
        "properties": {
          "dia": {
            "example": "MONDAY",
            "type": "string"
          },
          "horaFin": {
            "example": "15:00",
            "type": "string"
          },
          "horaInicio": {
            "example": "11:30",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "sedeId": {
            "format": "uuid",
            "type": "string"
          },
          "servicioId": {
            "format": "uuid",
            "type": "string"
          },
          "servicioNombre": {
            "example": "Almuerzo",
            "type": "string"
          }
        },
        "required": [
          "id",
          "servicioId",
          "sedeId",
          "dia",
          "horaInicio",
          "horaFin"
        ],
        "type": "object"
      },
      "IngresoConContrasenaRequest": {
        "properties": {
          "contrasena": {
            "example": "almuerzo2026",
            "type": "string"
          },
          "correo": {
            "example": "marta@lavecina.co",
            "type": "string"
          },
          "dispositivo": {
            "$ref": "#/components/schemas/DispositivoRequest"
          }
        },
        "required": [
          "correo",
          "contrasena",
          "dispositivo"
        ],
        "type": "object"
      },
      "IngresoConPinRequest": {
        "properties": {
          "celular": {
            "description": "Celular como lo escribe la persona",
            "example": "310 000 0102",
            "type": "string"
          },
          "dispositivo": {
            "$ref": "#/components/schemas/DispositivoRequest"
          },
          "pin": {
            "example": "482915",
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "celular",
          "pin",
          "dispositivo"
        ],
        "type": "object"
      },
      "IngresoResponse": {
        "properties": {
          "nombre": {
            "example": "Jhon",
            "type": "string"
          },
          "requiereCambioDePin": {
            "description": "Entró con un PIN temporal: debe crear el suyo antes de seguir",
            "type": "boolean"
          },
          "sesion": {
            "$ref": "#/components/schemas/SesionResponse"
          },
          "tokenCambio": {
            "description": "Solo si requiereCambioDePin. Dura 10 minutos.",
            "type": "string"
          }
        },
        "required": [
          "requiereCambioDePin",
          "nombre"
        ],
        "type": "object"
      },
      "InvitacionResponse": {
        "properties": {
          "membresiaId": {
            "format": "uuid",
            "type": "string"
          },
          "pinTemporal": {
            "description": "Se muestra una sola vez. null si la persona ya tenía PIN propio.",
            "example": "482915",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "membresiaId"
        ],
        "type": "object"
      },
      "InvitarCajeroRequest": {
        "properties": {
          "apellidos": {
            "example": "Jacanamejoy",
            "type": "string"
          },
          "celular": {
            "example": "312 456 7890",
            "type": "string"
          },
          "nombres": {
            "example": "Ana Lucía",
            "type": "string"
          },
          "numeroDocumento": {
            "example": "1124500777",
            "type": "string"
          },
          "tipoDocumento": {
            "description": "Código del tipo de documento (catálogo)",
            "example": "CC",
            "type": "string"
          }
        },
        "required": [
          "celular",
          "nombres",
          "tipoDocumento",
          "numeroDocumento"
        ],
        "type": "object"
      },
      "MiembroResponse": {
        "properties": {
          "celular": {
            "example": "+573100000102",
            "nullable": true,
            "type": "string"
          },
          "estado": {
            "enum": [
              "INVITED",
              "ACTIVE",
              "SUSPENDED",
              "REMOVED"
            ],
            "type": "string"
          },
          "membresiaId": {
            "format": "uuid",
            "type": "string"
          },
          "nombre": {
            "example": "Jhon Mutumbajoy",
            "type": "string"
          },
          "roles": {
            "example": [
              "CASHIER"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "usuarioId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "membresiaId",
          "usuarioId",
          "nombre",
          "estado",
          "roles"
        ],
        "type": "object"
      },
      "PinClienteResponse": {
        "properties": {
          "nombre": {
            "description": "Nombre enmascarado para confirmar",
            "example": "Luz Marina C.",
            "type": "string"
          },
          "pinTemporal": {
            "description": "Se dicta una sola vez a la persona",
            "example": "730284",
            "type": "string"
          }
        },
        "required": [
          "pinTemporal",
          "nombre"
        ],
        "type": "object"
      },
      "PinNuevoRequest": {
        "properties": {
          "dispositivo": {
            "$ref": "#/components/schemas/DispositivoRequest"
          },
          "pinNuevo": {
            "example": "730284",
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "tokenCambio": {
            "description": "Token que entregó el ingreso con PIN temporal",
            "type": "string"
          }
        },
        "required": [
          "tokenCambio",
          "pinNuevo",
          "dispositivo"
        ],
        "type": "object"
      },
      "PinTemporalResponse": {
        "properties": {
          "pinTemporal": {
            "description": "Se muestra una sola vez",
            "example": "482915",
            "type": "string"
          }
        },
        "required": [
          "pinTemporal"
        ],
        "type": "object"
      },
      "RenovarSesionRequest": {
        "properties": {
          "tokenRenovacion": {
            "type": "string"
          }
        },
        "required": [
          "tokenRenovacion"
        ],
        "type": "object"
      },
      "RespuestaErrorDto": {
        "properties": {
          "codigo": {
            "example": "HORARIO_SE_CRUZA",
            "type": "string"
          },
          "message": {
            "example": "Ese horario se cruza con otro del mismo día en esta sede.",
            "type": "string"
          },
          "statusCode": {
            "example": 422,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "codigo",
          "message"
        ],
        "type": "object"
      },
      "RestablecerPinClienteRequest": {
        "properties": {
          "celular": {
            "example": "310 000 0103",
            "type": "string"
          },
          "numeroDocumento": {
            "description": "El que dice la persona por teléfono",
            "example": "1124500003",
            "type": "string"
          },
          "tipoDocumento": {
            "example": "CC",
            "type": "string"
          }
        },
        "required": [
          "celular",
          "tipoDocumento",
          "numeroDocumento"
        ],
        "type": "object"
      },
      "SaludResponse": {
        "properties": {
          "baseDatos": {
            "enum": [
              "ok",
              "sin-conexion"
            ],
            "type": "string"
          },
          "estado": {
            "enum": [
              "ok",
              "degradado"
            ],
            "type": "string"
          },
          "version": {
            "example": "0.1.0+abc1234",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "baseDatos",
          "version"
        ],
        "type": "object"
      },
      "SesionEnDispositivoResponse": {
        "properties": {
          "abiertaDesde": {
            "format": "date-time",
            "type": "string"
          },
          "nombre": {
            "example": "Jhon",
            "type": "string"
          },
          "sesionId": {
            "format": "uuid",
            "type": "string"
          },
          "ultimoUso": {
            "format": "date-time",
            "type": "string"
          },
          "usuarioId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "sesionId",
          "usuarioId",
          "nombre",
          "abiertaDesde",
          "ultimoUso"
        ],
        "type": "object"
      },
      "SesionResponse": {
        "properties": {
          "espacios": {
            "items": {
              "$ref": "#/components/schemas/EspacioResponse"
            },
            "type": "array"
          },
          "segundosAcceso": {
            "example": 900,
            "type": "number"
          },
          "tokenAcceso": {
            "description": "Va en Authorization: Bearer. Dura 15 minutos.",
            "type": "string"
          },
          "tokenRenovacion": {
            "description": "Se cambia por uno nuevo en cada renovación; guárdelo seguro.",
            "type": "string"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioResponse"
          }
        },
        "required": [
          "tokenAcceso",
          "tokenRenovacion",
          "segundosAcceso",
          "usuario",
          "espacios"
        ],
        "type": "object"
      },
      "UsuarioResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "nombre": {
            "example": "Jhon",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "El vecino aliado de los negocios del Putumayo. Contrato para la app y el panel.",
    "title": "API de VECI",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/cuenta/comercio-activo": {
      "post": {
        "operationId": "elegirComercio",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComercioActivoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComercioActivoResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Sin sesión o sesión cerrada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaErrorDto"
                }
              }
            },
            "description": "No es uno de mis negocios"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Elige el negocio con el que trabajo",
        "tags": [
          "Mi cuenta"
        ]
      }
    },
    "/cuenta/correo-y-contrasena": {
      "put": {
        "operationId": "definirCorreoYContrasena",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorreoYContrasenaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorreoResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Sin sesión o sesión cerrada"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaErrorDto"
                }
              }
            },
            "description": "El correo es de otra cuenta"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaErrorDto"
                }
              }
            },
            "description": "Contraseña débil"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Correo y contraseña para entrar al panel (HU-02-02)",
        "tags": [
          "Mi cuenta"
        ]
      }
    },
    "/cuenta/espacios": {
      "get": {
        "operationId": "listarMisEspacios",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EspacioResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Sin sesión o sesión cerrada"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Comercios donde trabajo o soy cliente",
        "tags": [
          "Mi cuenta"
        ]
      }
    },
    "/cuenta/pin": {
      "put": {
        "operationId": "cambiarMiPin",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarPinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "Sin sesión o sesión cerrada"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaErrorDto"
                }
              }
            },
            "description": "PIN débil"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambia mi PIN",
        "tags": [
          "Mi cuenta"
        ]
      }
    },
    "/dispositivos": {
      "get": {
        "operationId": "listarDispositivos",
        "parameters": [
          {
            "description": "Id del negocio activo",
            "in": "header",
            "name": "x-veci-comercio",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DispositivoResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Falta el negocio activo"
          },
          "401": {
            "description": "Sin sesión o sesión cerrada"
          },
          "403": {
            "description": "Requiere el permiso tenancy.revoke_devices\n\nEl usuario no trabaja en ese negocio o su rol no alcanza"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Celulares de la caja y sus sesiones",
        "tags": [
          "Equipo del negocio"
        ]
      }
    },
    "/dispositivos/{dispositivoId}/cerrar-sesion": {
      "post": {
        "operationId": "cerrarSesionDispositivo",
        "parameters": [
          {
            "description": "Id del negocio activo",
            "in": "header",
            "name": "x-veci-comercio",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "dispositivoId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CierreRemotoResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Falta el negocio activo"
          },
          "401": {
            "description": "Sin sesión o sesión cerrada"
          },
          "403": {
            "description": "Requiere el permiso tenancy.revoke_devices\n\nEl usuario no trabaja en ese negocio o su rol no alcanza"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaErrorDto"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cierre remoto (HU-02-06)",
        "tags": [
          "Equipo del negocio"
        ]
      }
    },
    "/equipo": {
      "get": {
