# Copie este archivo a web/.env.local. Nunca suba el .env.local.
NEXT_PUBLIC_VECI_API_URL=http://localhost:3000
NEXT_PUBLIC_VECI_ENTORNO=desarrollo
NEXT_PUBLIC_VECI_VERSION=local
# URL de la API vista desde el servidor del panel (rutas /api/sesion/*). Si queda vacía se usa
# NEXT_PUBLIC_VECI_API_URL. Sirve cuando el servidor llega a la API por una red interna.
VECI_API_URL=
# Observabilidad (HU-01-07). Vacío = Sentry apagado.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN_WEB=
# Solo en el CI de despliegue, para subir mapas de fuente.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
