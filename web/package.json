{
  "name": "veci-web",
  "version": "0.1.0",
  "private": true,
  "description": "Panel web de VECI (Next.js) para propietarios y administración.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "arquitectura": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generar": "openapi-typescript ../docs/api/openapi.json -o src/shared/api/esquema.ts && node scripts/generar-tokens.mjs",
    "verificar": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arquitectura && pnpm test"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp",
      "unrs-resolver"
    ]
  }
}
