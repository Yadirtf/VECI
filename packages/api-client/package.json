{
  "name": "@veci/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente TypeScript del API de VECI, generado desde el contrato OpenAPI (HU-01-06).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "generar": "openapi-typescript openapi.json -o src/esquema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@veci/shared": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
