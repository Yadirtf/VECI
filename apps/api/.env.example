# Copie este archivo a apps/api/.env y ajuste los valores. Nunca suba el .env.
# desarrollo | pruebas | staging | produccion
VECI_ENTORNO=desarrollo
PORT=3000
# Dueño de los objetos: lo usan las migraciones y la semilla.
DATABASE_URL=postgresql://veci:veci@localhost:5432/veci
# Usuario de la API, miembro de veci_app y sujeto a RLS (HU-01-05).
DATABASE_APP_URL=postgresql://veci_api:veci_api@localhost:5432/veci
# Orígenes del panel separados por coma (CORS).
VECI_ORIGENES=http://localhost:3001
# Contrato en /docs (se apaga solo en producción).
VECI_DOCS=true
# Cabecera x-veci-usuario mientras llega EP-02 (se apaga solo en producción).
VECI_IDENTIDAD_DESARROLLO=true
# Observabilidad (HU-01-07). Vacío = Sentry apagado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
VECI_VERSION=local
