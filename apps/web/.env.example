# Copie este archivo a apps/web/.env.local. Nunca suba el .env.local.
NEXT_PUBLIC_VECI_API_URL=http://localhost:3000
NEXT_PUBLIC_VECI_ENTORNO=desarrollo
NEXT_PUBLIC_VECI_VERSION=local
# Comercio y usuario demo de la semilla, solo mientras llega el inicio de sesión (EP-02).
NEXT_PUBLIC_VECI_COMERCIO_DEMO=d1000000-0000-7000-8000-000000000001
NEXT_PUBLIC_VECI_USUARIO_DEMO=d4000000-0000-7000-8000-000000000001
# Observabilidad (HU-01-07). Vacío = Sentry apagado.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN_WEB=
# Solo en el CI de despliegue, para subir mapas de fuente.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
